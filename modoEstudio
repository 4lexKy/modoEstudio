#sudo apt install libnotify-bin

if [[ "$1" ==  "-d" ]]; then
    #Opción desatendido.
    segundoPlano $0
    echo -e "\n    Ejecutado >$(basename $0)< en modo segundo plano. Puedes cerrar la terminal.\n"
else
    echo -e "\n\tPara ejecutar en segundo plano usar la opción '-d'"

    echo -e "\n\tSegon plà: (el de PID menor)"
    pgrep -af $(basename "$0")
    echo

    echo "Empieza el tiempo..."
    notify-send 'Work Hard' 'Cada 15 minutos te recordaré que mires fuera' -i clock
    while [ true ]
    do
        sleep 15m
        notify-send 'Tiempooo' 'Mira fuera unos segundos' -i clock -t 60000
    done
fi
